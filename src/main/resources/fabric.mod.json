{
  "schemaVersion": 1,
  "id": "sclp",
  "version": "${version}",

  "name": "Sodium Chinese Localized Package",
  "description": "Sodium Chinese Localized Package will make Sodium support Chinese.",
  "authors": [
    "LoongLy"
  ],
  "contact": {
    "sources": "https://github.com/Long-Zixuan/Sodium_Chinese_Localization_Package",
    "issues": "https://github.com/Long-Zixuan/Sodium_Chinese_Localization_Package/issues"
  },

  "license": "LGPLv3",
  "icon": "assets/sclp/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "me.loongly.mods.sclp.client.SCLPClientMod"
    ]
  },
  "custom": {
    "modmenu": {
      "parent": {
        "id": "sodium"
      },
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/sodium-chinese-localization-package1-16-x",
        "modmenu.modrinth": "https://modrinth.com/mod/mc1.16.5-sodium-chinese-localization-pack",
        "modmenu.github_releases": "https://github.com/Long-Zixuan/Sodium_Chinese_Localization_Package/releases",
        "modmenu.donate": "https://ifdian.net/a/loongly",
        "modmenu.kofi": "https://ko-fi.com/loongly",
        "modmenu.discord": "https://discord.gg/rVbEMwzFFg"
      }
    }
  },
  "mixins": [
    "sclp.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.12.10",
    "java": ">=16",

    "sodium": [
      "0.3.x",
      "0.4.0-alpha5",
      "0.4.0-alpha6",
      "0.4.1"
    ]
  },

  "suggests": {
    "reeses-sodium-options": "*"
  },

  "conflicts": {
    "lambdabettergrass": "*"
  }
}
